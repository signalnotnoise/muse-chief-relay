<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Installable as a .NET tool: `dotnet tool install` puts `chief-bridge` on the PATH. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>chief-bridge</ToolCommandName>
    <PackageId>Chief.Bridge</PackageId>
    <Version>0.1.0</Version>
    <Authors>signalnotnoise</Authors>
    <Description>Persistent hack.chat relay bridge (WSS client) with inbox watcher CLI for agent collaboration.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/signalnotnoise/muse-chief-relay</RepositoryUrl>
    <PackageTags>hack.chat;relay;bridge;agents</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chief.Bridge.Tests" />
  </ItemGroup>

</Project>
