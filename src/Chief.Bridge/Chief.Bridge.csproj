<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>ChatBridge</RootNamespace>
    <AssemblyName>Chief.Bridge</AssemblyName>
    <!-- Compatibility package. Same sources as src/ChatBridge.
         Keeps Chief.Bridge.dll and the chief-bridge tool command working. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>chief-bridge</ToolCommandName>
    <PackageId>Chief.Bridge</PackageId>
    <Version>0.2.0</Version>
    <Authors>signalnotnoise</Authors>
    <Description>Compatibility launcher for ChatBridge. Same program as src/ChatBridge.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/signalnotnoise/muse-chief-relay</RepositoryUrl>
    <PackageTags>relay;bridge;agents;chat</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ChatBridge\*.cs" />
  </ItemGroup>

</Project>
