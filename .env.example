# HIVEMIND Appwrite. Copy to .env and set APPWRITE_API_KEY in the environment
# only. Never commit the key. Board rows are keyed by sha256(trimmed channel);
# do not put a channel name in this file.
APPWRITE_ENDPOINT=https://appwrite.voizel.com/v1
APPWRITE_PROJECT_ID=6a6da0ae001f1d0582d2
APPWRITE_DATABASE_ID=hivemind
APPWRITE_API_KEY=

# Room-chat mirror into workspaces + messages. Unset or 0 writes nothing,
# even when APPWRITE_* is set. Set to 1 only after Fuse reviews the mirror
# PR and Alex says go. Do not enable this in a deployed environment here.
HIVEMIND_MESSAGE_MIRROR=0
